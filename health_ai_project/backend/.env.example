# ============================================================
# MedAI Backend - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit the .env file to version control.
# ============================================================

# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True

# MySQL Database
MYSQL_DATABASE=medai_db
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password-here
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# ML Engine
MEDAI_FORCE_CPU=0
MEDAI_CUDA_DEVICE=0
MEDAI_RAG_ENABLED=1
MEDAI_RAG_CACHE_TTL=300
MEDAI_PRELOAD=0
MEDAI_MODEL_PRECISION=float32
